RewriteEngine On

# 1) HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.dsklinik\.dk$ [NC]
RewriteRule ^ https://dsklinik.dk%{REQUEST_URI} [R=301,L]

# 2) Legacy case/sti → korrekt sti + trailing slash
RewriteCond %{THE_REQUEST} \s/+OmOs(?:[?\s]|/|$) [NC]
RewriteRule ^OmOs/?$ https://dsklinik.dk/omos/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+KontaktOs(?:[?\s]|/|$) [NC]
RewriteRule ^KontaktOs/?$ https://dsklinik.dk/kontaktos/ [R=301,L]

# Legacy /Behandlinger → Botox-siden (genaktiveret)
RewriteCond %{THE_REQUEST} \s/+Behandlinger/ [NC]
RewriteRule ^Behandlinger/?$ https://dsklinik.dk/behandlinger/botox/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+Behandlinger/ [NC]
RewriteRule ^Behandlinger/([^/]+)/?$ https://dsklinik.dk/behandlinger/$1/ [R=301,L]

# 2b) Kendte URL'er med store bogstaver fra Googles indeks -> kanonisk version
RewriteRule ^behandlinger/PRP/?$ https://dsklinik.dk/behandlinger/prp/ [R=301,L]
RewriteRule ^behandlinger/Botox/?$ https://dsklinik.dk/behandlinger/botox/ [R=301,L]
RewriteRule ^behandlinger/Filler/?$ https://dsklinik.dk/behandlinger/filler/ [R=301,L]
RewriteRule ^behandlinger/Behandlinger/?$ https://dsklinik.dk/behandlinger/botox/ [R=301,L]

# 2c) /booking findes ikke som side (152 eksponeringer i GSC) -> kontakt
RewriteRule ^booking/?$ https://dsklinik.dk/kontaktos/ [R=301,L]

# 3) Tilføj trailing slash, hvis der findes en rigtig mappe
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ https://dsklinik.dk/$1/ [R=301,L]

# 4) Alle sider er prerenderet. Ukendte URL'er skal give en aegte 404,
#    ikke forsiden med status 200 (soft 404 = Google indekserer skrald)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]

ErrorDocument 404 /404.html

# 5) Komprimering
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# 6) Cache: statiske assets har hash i filnavnet og kan caches laenge
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpe?g|svg|woff2?|mp4|ico)$">
    Header set Cache-Control "public, max-age=15552000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>